PORT=3000
NODE_ENV=development

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pooler user MUST be postgres.PROJECT_REF (not just postgres)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Companion AI (ChatGPT-style replies). Prefer OpenAI for natural voice.
# Set at least one. OpenAI unlocks /api/assistant/speak (human TTS).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
